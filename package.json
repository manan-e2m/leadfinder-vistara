{
  "name": "leadfinder",
  "version": "0.1.0",
  "private": true,
  "description": "E2M Lead Finding & Prospecting — instant ICP-to-prospect engine for agency owners (Vistara 2027)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db && npm run db:push && npm run db:seed",
    "use:sqlite": "node scripts/use-db.mjs sqlite",
    "use:postgres": "node scripts/use-db.mjs postgresql",
    "precompute": "tsx scripts/precompute.ts",
    "setup": "npm install && npm run db:push && npm run db:seed"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
