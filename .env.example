# ─────────────────────────────────────────────────────────────
# LeadFinder — environment
# The platform runs end to end with NO keys at all: every provider
# falls back to its mock adapter. Add a key and the matching live
# adapter switches on automatically. Nothing else changes.
# ─────────────────────────────────────────────────────────────

DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3100"

# Per-run hard cost ceiling, in US cents. Enforced in the worker.
# A run that would exceed it degrades (template openers, cached audits)
# rather than overspending. Plan §9.3.
COST_CAP_CENTS=0

# Force every provider to mock regardless of keys present.
# Useful for demos, load tests and the offline event fallback.
PROVIDER_MODE=auto          # auto | mock | live

# ── Sourcing ────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
APOLLO_API_KEY=

# ── Audits ──────────────────────────────────────────────────
PAGESPEED_API_KEY=          # PageSpeed Insights / CrUX. Free, rate limited.
META_AD_LIBRARY_TOKEN=      # Meta Ad Library. Free.

# ── Verification ────────────────────────────────────────────
PHONE_VERIFY_API_KEY=       # line type + carrier lookup
EMAIL_VERIFY_API_KEY=       # syntax + MX

# ── Personalization ─────────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS_PER_RUN=40000

# ── Delivery ────────────────────────────────────────────────
GHL_API_KEY=                # GoHighLevel / LeadConnector — first
GHL_LOCATION_ID=
HUBSPOT_ACCESS_TOKEN=       # second
RESEND_API_KEY=             # transactional email for the dashboard link

# ── E2M proprietary layer ───────────────────────────────────
# Anonymized corpus of 10,000+ delivered sites. Additive: absent
# means benchmark lines are simply omitted, never faked. Plan §8.1
E2M_BENCHMARK_CORPUS_URL=
